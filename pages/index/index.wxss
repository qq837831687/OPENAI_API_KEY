.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #475569;
  font-size: 26rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.08);
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.input,
.picker-value {
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.primary {
  margin-top: 8rpx;
  background: #0f172a;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.result {
  margin-top: 32rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
}

.result-card {
  margin-top: 16rpx;
  background: #e2e8f0;
  border-radius: 20rpx;
  padding: 24rpx;
}

.result-text {
  color: #0f172a;
  font-size: 26rpx;
  line-height: 1.6;
}
